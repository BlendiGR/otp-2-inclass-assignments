<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="FuelCalculatorController"
      spacing="14"
      stylesheets="@style.css">

    <Label text="Fuel Consumption &amp; Trip Cost Calculator" styleClass="title-label"/>
    <Label text="Author: blend" styleClass="author-label"/>

    <Separator/>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <Button fx:id="btnEN" text="EN" onAction="#handleEN" styleClass="lang-button"/>
        <Button fx:id="btnFR" text="FR" onAction="#handleFR" styleClass="lang-button"/>
        <Button fx:id="btnJP" text="JP" onAction="#handleJP" styleClass="lang-button"/>
        <Button fx:id="btnIR" text="IR" onAction="#handleIR" styleClass="lang-button"/>
    </HBox>

    <Separator/>

    <GridPane hgap="12" vgap="10">
        <columnConstraints>
            <ColumnConstraints minWidth="210" prefWidth="230"/>
            <ColumnConstraints prefWidth="200"/>
        </columnConstraints>

        <Label fx:id="lblDistance" text="Distance (km):" styleClass="form-label"
               GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtDistance" promptText="e.g. 180"
                   GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label fx:id="lblConsumption" text="Fuel Consumption (L/100 km):" styleClass="form-label"
               GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtConsumption" promptText="e.g. 6.5"
                   GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label fx:id="lblPrice" text="Fuel Price (per liter):" styleClass="form-label"
               GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtPrice" promptText="e.g. 2.05"
                   GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    </GridPane>

    <Button fx:id="btnCalculate" text="Calculate Trip Cost"
            onAction="#handleCalculate"
            maxWidth="Infinity"
            styleClass="calculate-button"/>

    <Label fx:id="lblResult" text="" wrapText="true"
           maxWidth="Infinity"
           styleClass="result-label"/>

</VBox>